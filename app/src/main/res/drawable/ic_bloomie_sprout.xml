<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="140dp"
    android:height="110dp"
    android:viewportWidth="140"
    android:viewportHeight="110">

    <!-- 1. LEFT LEAF (Wider, Curvy Shape with Watercolor Gradient) -->
    <path android:pathData="M68,76 C52,72 34,52 40,30 C58,28 74,48 68,76 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="68"
                android:endY="76"
                android:startX="38"
                android:startY="30"
                android:type="linear">
                <item
                    android:color="#829E81"
                    android:offset="0.0" />
                <item
                    android:color="#658265"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Left leaf center vein -->
    <path
        android:pathData="M68,76 C58,62 49,48 44,37"
        android:strokeColor="#486349"
        android:strokeLineCap="round"
        android:strokeWidth="1.8" />

    <!-- 2. RIGHT LEAF (Asymmetrical & Pointed with Watercolor Gradient) -->
    <path android:pathData="M71,72 C74,52 92,38 112,42 C108,64 88,74 71,72 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="112"
                android:endY="42"
                android:startX="71"
                android:startY="72"
                android:type="linear">
                <item
                    android:color="#617E61"
                    android:offset="0.0" />
                <item
                    android:color="#7F9B7E"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Right leaf center vein -->
    <path
        android:pathData="M71,72 C82,61 94,51 104,44"
        android:strokeColor="#486349"
        android:strokeLineCap="round"
        android:strokeWidth="1.8" />

    <!-- 3. CURVED STEM -->
    <path
        android:pathData="M68,74 Q65,88 67,102"
        android:strokeColor="#3E6149"
        android:strokeLineCap="round"
        android:strokeWidth="3.8" />

    <!-- 4. BLUSH PINK & CREAM SPARKLES -->
    <!-- Left soft beige 4-point sparkle -->
    <path
        android:fillColor="#EAE3D8"
        android:pathData="M24,48 Q24.6,54 30,54.5 Q24.6,55 24,61 Q23.4,55 18,54.5 Q23.4,54 24,48 Z" />

    <!-- Top-right larger pink sparkle -->
    <path
        android:fillColor="#F4C7CB"
        android:pathData="M92,12 Q93,24 105,25 Q93,26 92,38 Q91,26 79,25 Q91,24 92,12 Z" />

    <!-- Lower-right small pink sparkle -->
    <path
        android:fillColor="#F5D8DA"
        android:pathData="M116,34 Q116.6,40 122,40.5 Q116.6,41 116,47 Q115.4,41 110,40.5 Q115.4,40 116,34 Z" />

    <!-- Tiny rightmost pink dot -->
    <path
        android:fillColor="#F5D8DA"
        android:pathData="M128,44 A2,2 0 1,1 127.9,44 Z" />
</vector>