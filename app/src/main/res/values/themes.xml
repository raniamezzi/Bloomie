<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style name="Theme.Bloomie" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Brand colors -->
        <item name="colorPrimary">@color/sage_green</item>
        <item name="colorPrimaryVariant">@color/sage_green_dark</item>
        <item name="colorOnPrimary">@color/on_sage</item>
        <item name="colorSecondary">@color/sage_green</item>
        <item name="colorSecondaryVariant">@color/sage_green_dark</item>
        <item name="colorOnSecondary">@color/on_sage</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/bg_cream</item>
        <item name="colorSurface">@color/surface_white</item>
        <item name="colorOnBackground">@color/text_dark</item>
        <item name="colorOnSurface">@color/text_dark</item>
        <item name="colorError">@color/status_overdue</item>
        <item name="colorOnError">@color/white</item>

        <!-- Text -->
        <item name="android:textColorPrimary">@color/text_dark</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:textColorHint">@color/text_hint</item>

        <!-- System bars: cream status bar with dark icons -->
        <item name="android:statusBarColor">@color/bg_cream</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/bg_cream</item>

        <!-- Component defaults -->
        <item name="materialButtonStyle">@style/Widget.Bloomie.Button</item>
        <item name="colorControlActivated">@color/sage_green</item>
        <item name="android:textColorHighlight">@color/badge_sage</item>
    </style>

    <!-- Splash screen: warm cream background with dark status bar icons -->
    <style name="Theme.Bloomie.Splash" parent="Theme.Bloomie">
        <item name="android:windowBackground">@color/bg_cream</item>
        <item name="android:statusBarColor">@color/bg_cream</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Filled pill button -->
    <style name="Widget.Bloomie.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/sage_green</item>
        <item name="android:textColor">@color/on_sage</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Outlined pill button -->
    <style name="Widget.Bloomie.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/sage_green</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/sage_green</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

</resources>